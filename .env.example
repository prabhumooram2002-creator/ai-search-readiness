# Secrets — DO NOT commit this file to version control
# Copy to .env and fill in your values

# NVIDIA NIM (free tier) — primary for embeddings + chat
# Get a key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API (optional fallback)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Qdrant (optional — defaults to ChromaDB local)
QDRANT_URL=
QDRANT_API_KEY=

# Neo4j (optional — defaults to KuzuDB local)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
