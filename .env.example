# AI Search Readiness Platform — configuration
# Copy to .env and edit only if you want to opt into an external provider.
# DEFAULTS ARE FULLY LOCAL: with this file copied verbatim (no keys), the tool
# runs end to end offline once local models are pulled. Do NOT commit .env.

# ── Provider selection (defaults are local; no keys required) ────────────────
# LLM_PROVIDER: ollama (local, default) | deepseek (needs DEEPSEEK_API_KEY)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct

# EMBED_PROVIDER: local (BGE-M3, default) | nvidia (needs NVIDIA_API_KEY)
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-m3          # 1024-dim, matches the Kuzu FLOAT[1024] schema

# ── Optional external providers (leave blank to stay fully local) ────────────
# If a provider above is selected but its key is blank, the tool logs a warning
# and falls back to the local default.
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# ── Optional external stores (leave blank to use embedded ChromaDB + KuzuDB) ─
QDRANT_URL=
QDRANT_API_KEY=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ── Memory-constrained-machine swaps (see README "Notes on the local model
#    stack") — the full local model set is ~6-8GB combined; on a machine
#    without that headroom, these swap in lighter models with no code change.
#    All commented out (i.e. inactive) by default.
# GLINER_MODEL=urchade/gliner_small-v2.1              # ~400MB vs ~1.8GB large
# SPACY_MODEL=en_core_web_sm                          # ~13MB vs the transformer default
# RELATION_PROVIDER=llm                                # routes through the LLM instead of loading GLiREL (~1.8GB)
# SKIP_RELATIONS=1                                     # last resort: no relationship edges at all
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2  # ~80MB vs ~2.2GB bge-reranker-v2-m3
